# Required: replace with a strong, demo-specific secret (do not commit the value).
MAWI_API_BEARER_TOKEN=

# Safe hosted-demo defaults.
MAWI_API_AUTH_MODE=protected
MAWI_DEMO_MODE=true
MAWI_LLM_ENABLED=false
MAWI_DB_PATH=/data/mawi.db

# Optional LLM mode only; never required for the deterministic demo.
# OPENAI_API_KEY=
# MAWI_LLM_PROVIDER=openai
# MAWI_OPENAI_MODEL=gpt-4.1-mini
